 "lines": [
  {
   "t": 21.0,
   "text": "Cracked mirror in the corner of my brain"
  },
  {
   "t": 25.3,
   "text": "Each shard whispers"
  },
  {
   "t": 27.1,
   "text": "\"You're not insane\""
  },
  {
   "t": 29.0,
   "text": "I feed the chaos"
  },
  {
   "t": 30.8,
   "text": "I light the spark"
  },
  {
   "t": 32.6,
   "text": "Turn my shadow into art"
  },
  {
   "t": 35.6,
   "text": "Splitting atoms in the palms of my hands"
  },
  {
   "t": 39.8,
   "text": "Twist the strings of the mind"
  },
  {
   "t": 42.5,
   "text": "Make it dance"
  },
  {
   "t": 43.9,
   "text": "A laugh that echoes"
  },
  {
   "t": 46.1,
   "text": "Sharp and wild"
  },
  {
   "t": 47.5,
   "text": "Freud and Jung in exile"
  },
  {
   "t": 50.6,
   "text": "Exiled"
  },
  {
   "t": 59.5,
   "text": "Who says madness can't be tamed"
  },
  {
   "t": 63.1,
   "text": "Who says fire can't be framed"
  },
  {
   "t": 72.0,
   "text": "Mad alchemy"
  },
  {
   "t": 74.3,
   "text": "The gift"
  },
  {
   "t": 75.5,
   "text": "The curse"
  },
  {
   "t": 76.8,
   "text": "Spinning gold from the universe"
  },
  {
   "t": 80.8,
   "text": "Mad alchemy"
  },
  {
   "t": 83.0,
   "text": "Create"
  },
  {
   "t": 83.8,
   "text": "Destroy"
  },
  {
   "t": 85.0,
   "text": "Unleashing madness as my ploy"
  },
  {
   "t": 92.5,
   "text": "Paint the dark with colors untold"
  },
  {
   "t": 97.6,
   "text": "Words like weapons"
  },
  {
   "t": 100.3,
   "text": "Sharp and cold"
  },
  {
   "t": 102.4,
   "text": "Tongue's a scalpel"
  },
  {
