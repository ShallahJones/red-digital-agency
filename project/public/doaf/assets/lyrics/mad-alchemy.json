   "text": "Cuts so deep"
  },
  {
   "t": 107.7,
   "text": "Wake the monsters that I keep"
  },
  {
   "t": 114.0,
   "text": "Cages crumble"
  },
  {
   "t": 116.4,
   "text": "I break the lock"
  },
  {
   "t": 118.6,
   "text": "Madness fuels this ticking clock"
  },
  {
   "t": 122.3,
   "text": "Not a victim"
  },
  {
